{
  "name": "vayu-site",
  "version": "1.0.0",
  "private": true,
  "description": "Vayu storefront and admin panel on Cloudflare Workers + D1 + R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply vayu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vayu-db --remote",
    "db:import": "node scripts/import-db.mjs --local",
    "db:import:remote": "node scripts/import-db.mjs --remote",
    "legacy": "node server.cjs"
  },
  "devDependencies": {
    "wrangler": "^4.60.0"
  }
}
