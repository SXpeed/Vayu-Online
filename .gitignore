node_modules/

# wrangler's local state: the dev D1 database, R2 bucket and caches
.wrangler/

# generated by scripts/import-db.mjs
scripts/import.generated.sql

# the legacy Node server's data file and its snapshots. On Cloudflare the
# database of record is D1 — this is kept only as the migration source and
# for `npm run legacy`.
admin/data/backups/

.DS_Store
*.log

# wrangler dev secrets
.dev.vars

# esbuild output — regenerate with `npm run build`
public/assets/js/

# SvelteKit's generated app and the adapter's worker bundle — both are build
# output, rebuilt by `npm run build` on every deploy.
.svelte-kit/
