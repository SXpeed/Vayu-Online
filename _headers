# Vayu — response headers for everything Workers Assets serves.
#
# At the project root, not in public/: @sveltejs/adapter-cloudflare throws on
# startup if it finds a _headers in the assets directory, and appends its own
# autogenerated block (the immutable caching for /_app/immutable/*) to this
# file on the way out. _redirects sits here for the same reason.
#
# There were no security headers on this site at all before this file. Every
# one below is chosen because it cannot break a page that works today; the one
# header that WOULD need per-page testing is called out at the bottom rather
# than switched on quietly.

/*
  # The shop's own pages must never be framed. Clickjacking against a
  # storefront is not academic: an invisible overlay over "Add to cart" or a
  # checkout button is the whole attack, and it costs nothing to refuse.
  # Both spellings, because the CSP form is authoritative in current browsers
  # and the header form is what older ones read.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

  # Never let a browser second-guess a declared Content-Type. Without this a
  # file served as one type can be executed as another, which turns every
  # upload endpoint into a maybe.
  X-Content-Type-Options: nosniff

  # Send the full URL to ourselves, the bare origin to anyone else. The
  # default leaks the whole path cross-origin, and on a shop the path is the
  # product someone was looking at.
  Referrer-Policy: strict-origin-when-cross-origin

  # https only, for a year, across the subdomains — admin. and api. are both
  # https already, so this states what is true rather than changing anything.
  # Deliberately without `preload`: that submits the domain to a browser-baked
  # list which is slow and awkward to undo, and is a decision to take on
  # purpose rather than inherit from a config file.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # The shop asks for none of these, so nothing on the page — including
  # anything a third-party script pulls in — may ask either.
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Detach from any window that opened us, without breaking a window we open.
  # The plain `same-origin` value would sever an OAuth popup from its opener
  # and hang the sign-in; `-allow-popups` keeps that flow working.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# --- caching -------------------------------------------------------------
#
# Only /_app/immutable/* had a cache policy before this, from the block the
# adapter appends below. Everything else fell through to the Workers Assets
# default, `max-age=0, must-revalidate` — so every AVIF on the site was
# revalidated before the browser was allowed to reuse its own copy. The bytes
# were cached and each answer was a 304 with an empty body, but it still cost
# a round trip per image per page view, on files that change on deploy and
# not otherwise.
#
# WHY NOT `immutable`, which is what /_app/immutable/* gets: those filenames
# carry a content hash, so the URL permanently identifies those exact bytes
# and "never revalidate" is the truth. `hero.avif` carries no hash — the same
# name can hold new bytes after any deploy — and a year of `immutable` would
# strand a replaced picture in visitors' caches with no way to reach them.
#
# `stale-while-revalidate` is what makes the bounded version nearly as fast.
# Inside the SWR window the browser paints its cached copy IMMEDIATELY and
# revalidates in the background, so a repeat visit pays no blocking round
# trip either. The cost of a replaced image is that a returning visitor may
# see the old one once before the background fetch lands.
#
# Content-hashing these filenames would earn a real `immutable`, and it was
# considered. It breaks the _redirects rules that keep every legacy
# /assets/images/*.png name resolving: a static rewrite is a literal
# substitution and cannot compute a hash, so every external link and indexed
# image URL would 404. Not worth it for the last few percent.
/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The social card, on the same terms. Unfurlers cache hard anyway.
/assets/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.svg
  Cache-Control: public, max-age=604800

# HTML is deliberately absent from all of the above. A page must revalidate
# every time or an edit made in the admin panel would not appear until a
# visitor's cache expired, which is the one thing the shop would notice.

# NOT SET, and it is the notable absence: a full Content-Security-Policy
# naming script-src/style-src/img-src/connect-src. It is the single biggest
# remaining hardening step, and it is also the one that breaks a live shop if
# it is guessed at — Razorpay's checkout, Google Fonts and any analytics tag
# each need naming, and a missed one fails as a blank page at the moment
# somebody is trying to pay. It wants a pass in report-only mode against real
# traffic first. See README-cloudflare.md.
